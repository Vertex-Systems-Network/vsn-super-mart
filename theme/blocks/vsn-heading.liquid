      "visible_if": "{{ block.settings.simple_mode == false and block.settings.adv == true }}"
    },
    {
      "type": "number",
      "id": "size_1920",
      "label": "Font size \u2014 1920 override",
      "visible_if": "{{ block.settings.simple_mode == false and block.settings.adv == true }}"
    },
    {
      "type": "number",
      "id": "size_2448",
