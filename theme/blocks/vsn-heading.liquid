    },
    {
      "type": "number",
      "id": "size_320",
      "label": "Font size \u2014 320 override",
      "visible_if": "{{ block.settings.simple_mode == false and block.settings.adv == true }}"
    },
    {
      "type": "number",
      "id": "size_480",
      "label": "Font size \u2014 480 override",
      "visible_if": "{{ block.settings.simple_mode == false and block.settings.adv == true }}"
    },
    {
      "type": "number",
      "id": "size_560",
