{% doc %}
VSN element: Button (rule 15). Variations solid/ghost/brutal/glass, responsive size, full width per device.
  Self-contained block: callers leave the body empty.
{% enddoc %}
{%- liquid
  assign scope = '#vsn-' | append: block.id
  assign variation = block.settings.variation
  if variation == 'inherit'
    assign variation = settings.vsn_button_variation
  endif
-%}
{% style %}
  {{ scope }}{--vsn-full-d:{% if block.settings.full_d %}100%{% else %}auto{% endif %};--vsn-full-t:{% if block.settings.full_t %}100%{% else %}auto{% endif %};--vsn-full-m:{% if block.settings.full_m %}100%{% else %}auto{% endif %}}
  {% render 'vsn-responsive', scope: scope, prop: 'bh', d: block.settings.height_d, t: block.settings.height_t, m: block.settings.height_m, adv: block.settings.adv, o320: block.settings.height_320, o480: block.settings.height_480, o560: block.settings.height_560, o1024: block.settings.height_1024, o1920: block.settings.height_1920, o2448: block.settings.height_2448 %}
{% endstyle %}
<a
  id="vsn-{{ block.id }}"
  href="{{ block.settings.link | default: routes.all_products_collection_url }}"
  class="vsn-button vsn-button--{{ variation }} {{ block.settings.css_class | escape }}"
  {{ block.shopify_attributes }}
>
  <span>{{ block.settings.label | escape }}</span>
  {%- if block.settings.icon == 'arrow' -%}
    <svg class="vsn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  {%- endif -%}
</a>

{% schema %}
{
  "name": "VSN Button",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Shop the drop"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "variation",
      "label": "Style variation",
      "options": [
        {
          "value": "inherit",
          "label": "Theme default"
        },
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "ghost",
          "label": "Ghost"
        },
        {
          "value": "brutal",
          "label": "Brutal (offset shadow)"
        },
        {
          "value": "glass",
          "label": "Glass"
        }
      ],
      "default": "inherit",
      "visible_if": "{{ block.settings.simple_mode == false }}"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "arrow",
          "label": "Arrow"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ block.settings.simple_mode == false }}"
    },
    {
      "type": "header",
      "content": "Height",
      "visible_if": "{{ block.settings.simple_mode == false }}"
    },
    {
      "type": "number",
      "id": "height_d",
      "label": "Height \u2014 desktop (1440) px",
      "default": 56,
      "visible_if": "{{ block.settings.simple_mode == false }}"
    },
    {
      "type": "number",
      "id": "height_t",
      "label": "Height \u2014 tablet (768) px",
      "default": 52,
      "visible_if": "{{ block.settings.simple_mode == false }}"
    },
    {
      "type": "number",
      "id": "height_m",
      "label": "Height \u2014 mobile (360) px",
      "default": 48,
      "visible_if": "{{ block.settings.simple_mode == false }}"
    },
    {
      "type": "number",
      "id": "height_320",
      "label": "Height \u2014 320 override",
      "visible_if": "{{ block.settings.simple_mode == false and block.settings.adv == true }}"
    },
    {
      "type": "number",
      "id": "height_480",
      "label": "Height \u2014 480 override",
      "visible_if": "{{ block.settings.simple_mode == false and block.settings.adv == true }}"
    },
    {
      "type": "number",
      "id": "height_560",
      "label": "Height \u2014 560 override",
      "visible_if": "{{ block.settings.simple_mode == false and block.settings.adv == true }}"
    },
    {
      "type": "number",
      "id": "height_1024",
      "label": "Height \u2014 1024 override",
      "visible_if": "{{ block.settings.simple_mode == false and block.settings.adv == true }}"
    },
    {
      "type": "number",
      "id": "height_1920",
      "label": "Height \u2014 1920 override",
      "visible_if": "{{ block.settings.simple_mode == false and block.settings.adv == true }}"
    },
    {
      "type": "number",
      "id": "height_2448",
      "label": "Height \u2014 2448 override",
      "visible_if": "{{ block.settings.simple_mode == false and block.settings.adv == true }}"
    },
    {
      "type": "header",
      "content": "Full width",
      "visible_if": "{{ block.settings.simple_mode == false }}"
    },
    {
      "type": "checkbox",
      "id": "full_d",
      "label": "Full width \u2014 desktop",
      "default": false,
      "visible_if": "{{ block.settings.simple_mode == false }}"
    },
    {
      "type": "checkbox",
      "id": "full_t",
      "label": "Full width \u2014 tablet",
      "default": false,
      "visible_if": "{{ block.settings.simple_mode == false }}"
    },
    {
      "type": "checkbox",
      "id": "full_m",
      "label": "Full width \u2014 mobile",
      "default": true,
      "visible_if": "{{ block.settings.simple_mode == false }}"
    },
    {
      "type": "header",
      "content": "Editing"
    },
    {
      "type": "checkbox",
      "id": "simple_mode",
      "label": "Simple mode (content only)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "adv",
      "label": "Advanced responsive (all 9 breakpoints)",
      "default": false,
      "visible_if": "{{ block.settings.simple_mode == false }}"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "Custom CSS class",
      "visible_if": "{{ block.settings.simple_mode == false }}"
    }
  ]
}
{% endschema %}
